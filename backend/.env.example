# Server
PORT=4000
NODE_ENV=development

# Database (single shared PostgreSQL)
DATABASE_URL=postgresql://dealflow_user:dealflow_pass@localhost:5432/dealflow360

# Auth
JWT_ACCESS_SECRET=replace_with_64_char_random_secret
JWT_REFRESH_SECRET=replace_with_64_char_random_secret
JWT_ACCESS_EXPIRES_IN=60m
JWT_REFRESH_EXPIRES_IN=7d

# Portal
CUSTOMER_PORTAL_TOKEN_EXPIRES_HOURS=72

# Frontend origin (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
